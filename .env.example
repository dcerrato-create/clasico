# Copy this file to ".env" (same folder) and fill in your own key.
# The real .env file is ignored by git and must never be committed.

# Your OpenAI API key (starts with "sk-")
OPENAI_API_KEY=

# Which OpenAI model writes the AI Story (small and cheap)
OPENAI_MODEL=gpt-4.1-mini

# Which websites may call the backend. "*" = any (fine for local work).
# After deploying, set this to the frontend address, e.g. https://dcerrato-create.github.io
ALLOWED_ORIGINS=*
